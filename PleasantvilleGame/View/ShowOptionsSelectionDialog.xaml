<Window x:Class="PleasantvilleGame.ShowOptionsSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PleasantvilleGame"
        mc:Ignorable="d"
        Topmost="True" 
        Title="Options Dialog" FontSize="20" Height="220" Width="310" WindowStartupLocation="CenterScreen">
   <ScrollViewer Name="myScrollViewerInside" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
      <Grid x:Name="myGrid" Height="179" >
         <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
         </Grid.RowDefinitions>
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="239*"/>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition Width="65*"/>
         </Grid.ColumnDefinitions>
         <GroupBox x:Name="myGroupBoxTutorialSkip" Grid.Row="0" Grid.Column="0" Header="Town Solo" FontSize="14"  Margin="10,0,10,10" Grid.ColumnSpan="3">
            <StackPanel Name="myStackPanelTutorialSkip" Orientation="Vertical" VerticalAlignment="Top" Margin="5,5,5,5" >
               <CheckBox x:Name="myCheckBoxAutoSetupTown"  Content="Automatic Setup Town" Margin="5,0,5,0" Padding="4,-4,0,0" Click="StackPanelAutoSetup_Click"/>
            </StackPanel>
         </GroupBox>
         <StackPanel Name="myStackPanelButtons" Grid.Row="1"  Orientation="Horizontal" VerticalAlignment="Center"  HorizontalAlignment="Left" Margin="78,0,0,0" >
            <Button x:Name="myButtonCancel" HorizontalAlignment="Center" Width="70" Height="30" VerticalAlignment="Top" Margin="0,0,10,0" FontSize="14" Click="ButtonCancel_Click" IsCancel="True">Cancel</Button>
            <Button x:Name="myButtonOK" HorizontalAlignment="Center" Width="70" Height="30" VerticalAlignment="Top" Margin="0,0,0,0" FontSize="14" Click="ButtonOk_Click" IsDefault="True">OK</Button>
         </StackPanel>
      </Grid>
   </ScrollViewer>
</Window>
