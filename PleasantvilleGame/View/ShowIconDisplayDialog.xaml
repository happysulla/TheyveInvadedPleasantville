<Window x:Class="PleasantvilleGame.ShowIconDisplayDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PleasantvilleGame"
        mc:Ignorable="d"
        Title="Icon Definitions" Height="600" Width="810" WindowStartupLocation="CenterScreen">
   <ScrollViewer Name="myScrollViewerInside" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
      <Grid x:Name="myGrid">
         <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="60"/>
         </Grid.RowDefinitions>
         <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="320"/>
         </Grid.ColumnDefinitions>
         <TextBox Grid.Row="0" Grid.Column="1" Height="100" Width="320" TextWrapping="Wrap" IsEnabled="False" Margin="0,8,0,0" Text="Alien head on a counter means that it is known to the Town player." />
         <TextBox Grid.Row="1" Grid.Column="1" Height="100" Width="320" TextWrapping="Wrap" IsEnabled="False"  Text="Implant may be removed from a alien player if the Town person wins in combat. If removed, the town person has an implant device. It adds one to the influence roll (making it easier) when the town player attempts to recruit others to fight"/>
         <TextBox Grid.Row="2" Grid.Column="1" Height="100" Width="320" TextWrapping="Wrap" IsEnabled="False"  Text="Killed-in-Action. When KIA, the counter's influence is disregarded at end of game. The counter is removed from the game." />
         <TextBox Grid.Row="3" Grid.Column="1" Height="100" Width="320" TextWrapping="Wrap" IsEnabled="False"  Text="Knocked-out counters are unconscious due to combat. When knocked out, their influence is not counted. Knocked-out aliens can be tied up but cannot be interrogated until awake. Knocked out Town counters become stunned after the combat phase of the next turn."/>
         <TextBox Grid.Row="4" Grid.Column="1" Height="100" Width="320" TextWrapping="Wrap" IsEnabled="False"  Text="Counters become skeptical due to a failed influence roll. Skeptical units subtract one (making it harder) to die roll for future influence attempts."/>

         <TextBox Grid.Row="0" Grid.Column="3" Height="100" Width="320" TextWrapping="Wrap" IsEnabled="False"  Margin="0,8,0,0" Text="Stunned only apply to Town counters due to combat. They revert to unstunned at end of next combat. They are retreated one space. They cannot be moved except due to random movement. They may not be influenced. However, they can be taken over by alien player."/>
         <TextBox Grid.Row="1" Grid.Column="3" Height="100" Width="320" TextWrapping="Wrap" IsEnabled="False"  Text="Alien counters may surrender (i.e., Give Up) due to combat. They can be interrogated, and if the implant device is removed, they convert to a Town controlled counter."/>
         <TextBox Grid.Row="2" Grid.Column="3" Height="100" Width="320" TextWrapping="Wrap" IsEnabled="False"  Text="Alien counters can be tied up if they surrender or are knocked out due to combat. They can be untied by the Alien player if they coexist with an alien controlled counter at end of game turn. When tied up, they do not count against stacking restrictions."/>
         <TextBox Grid.Row="3" Grid.Column="3" Height="100" Width="320" TextWrapping="Wrap" IsEnabled="False"  Text="Wary counters are uncontrolled townspeople who successfully witness an alien takeover. They cannot be taken over by the Alien player unless they are defeated in combat. They add one (making it easier) to future influence rolls."/>
         <StackPanel Name="myStackPanelButtons" Grid.Row="11" Grid.ColumnSpan="10"  Orientation="Horizontal" VerticalAlignment="Center"  HorizontalAlignment="Center" Margin="5,5,5,5" >
            <Button x:Name="myButtonOK" HorizontalAlignment="Center" Width="70" Height="30" VerticalAlignment="Top" Margin="0,10,0,0" FontSize="14" Click="ButtonOk_Click" IsDefault="True">OK</Button>
         </StackPanel>
      </Grid>
   </ScrollViewer>
</Window>
